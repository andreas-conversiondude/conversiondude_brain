--- a/snippets/card-gallery.liquid	2026-09-02 17:07:20.000000000 +0000
+++ b/snippets/card-gallery.liquid	2026-09-02 17:18:40.699207688 +0000
@@ -126,6 +126,46 @@
         assign media_list_to_show = all_media
       endif
 
+      # BAR-STOOL CARD IMAGE: display array (media_list_to_show) only.
+      # product.media is never modified.
+      # Bar stool cards lead with the white-background packshot (alt "collection
+      # thumbnail") while the PDP gallery leads with the lifestyle shot - see
+      # blocks/_product-media-gallery.liquid, which uses the same bar-stool test.
+      # The packshot is skipped when it belongs to a variant other than the
+      # selected one, because the hidden-variant rules below would hide it.
+      capture is_bar_stool
+        render 'pdp-redo-is-barstool', product: product
+      endcapture
+      assign is_bar_stool = is_bar_stool | strip
+
+      if is_bar_stool == 'true' and media_list_to_show.size > 1
+        assign packshot_media = '' | split: ','
+        assign remaining_media = '' | split: ','
+
+        for m in media_list_to_show
+          assign m_item = all_media | where: 'id', m.id
+          assign m_alt = m.alt | strip | downcase
+          assign pin_media = false
+
+          if m_alt == 'collection thumbnail' and packshot_media.size == 0
+            assign pin_media = true
+            if variant_images contains m.src and m.src != selected_variant_image
+              assign pin_media = false
+            endif
+          endif
+
+          if pin_media
+            assign packshot_media = packshot_media | concat: m_item
+          else
+            assign remaining_media = remaining_media | concat: m_item
+          endif
+        endfor
+
+        if packshot_media.size > 0
+          assign media_list_to_show = packshot_media | concat: remaining_media
+        endif
+      endif
+
       if all_media.size > 2 and generic_media_size > 0
         assign show_arrows = true
       endif
